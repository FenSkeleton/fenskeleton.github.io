<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1107">
	<defaultcontrol>9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>60%</centertop>
			<height>700</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="485" />
				<param name="header_label" value="$LOCALIZE[137] [COLOR accent_color][B]($VAR[CurrentSearchProviderVar])[/B][/COLOR]" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList</include>
				<content>
                                        <item>
                                                <label>Movies</label>
                                                <onclick>Dialog.Close(all)</onclick>
                                                <onclick>ActivateWindow(Videos,"plugin://plugin.video.fenskeleton/?action=movie&amp;mode=navigator.search_history&amp;name=Movies",return)</onclick>
                                        </item>
                                        <item>
                                                <label>TV Shows</label>
                                                <onclick>Dialog.Close(all)</onclick>
                                                <onclick>ActivateWindow(Videos,"plugin://plugin.video.fenskeleton/?action=tvshow&amp;mode=navigator.search_history&amp;name=TV%20Shows",return)</onclick>
                                        </item>
                                        <item>
                                                <label>Movie Collections</label>
                                                <onclick>Dialog.Close(all)</onclick>
                                                <onclick>ActivateWindow(Videos,"plugin://plugin.video.fenskeleton/?mode=build_movie_list&amp;action=tmdb_movies_search_sets",return)</onclick>
                                        </item>
                                        <item>
                                                <label>Actors/Actresses</label>
                                                <onclick>Dialog.Close(all)</onclick>
                                                <onclick>ActivateWindow(Videos,"plugin://plugin.video.fenskeleton/?action=people&amp;mode=navigator.search_history&amp;name=People",return)</onclick>
                                        </item>
                                        <item>
                                                <label>$VAR[KeywordMoviesLabelVar]</label>
                                                <onclick>Dialog.Close(all)</onclick>
                                                <onclick>ActivateWindow(Videos,"plugin://plugin.video.fenskeleton/?action=tmdb_keyword_movie&amp;mode=navigator.search_history&amp;name=Keywords%20(Movies)",return)</onclick>
                                        </item>
                                        <item>
                                                <label>$VAR[KeywordTVShowsLabelVar]</label>
                                                <onclick>Dialog.Close(all)</onclick>
                                                <onclick>ActivateWindow(Videos,"plugin://plugin.video.fenskeleton/?action=tmdb_keyword_tvshow&amp;mode=navigator.search_history&amp;name=Keywords%20(TV%20Shows)",return)</onclick>
                                        </item>
					<item>
						<label>Addons</label>
						<onclick>Dialog.Close(all)</onclick>
						<onclick>ActivateWindow(addonbrowser,addons://search/,return)</onclick>
					</item>
					<item>
						<label>YouTube</label>
						<onclick>Dialog.Close(all)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.youtube)">
							ActivateWindow(videos,"plugin://plugin.video.youtube/kodion/search/list/",return)</onclick>
						<onclick
							condition="System.HasAddon(plugin.video.youtube) + !System.AddonIsEnabled(plugin.video.youtube)">
							EnableAddon(plugin.video.youtube)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.youtube)">
							InstallAddon(plugin.video.youtube)</onclick>
					</item>
				</content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000" />
				<param name="posx" value="276" />
				<param name="up_posy" value="-40" />
				<param name="down_posy" value="500" />
			</include>
		</control>
	</controls>
</window>
